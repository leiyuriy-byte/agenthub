# ============================================================
# AgentHub Production Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!
# ============================================================

# ──────────────────────────────────────────────────────────────
# REQUIRED - Must be set before deployment
# ──────────────────────────────────────────────────────────────

# JWT Secret Key (generate with: openssl rand -base64 48 | tr -d '/+=' | head -c 64)
JWT_SECRET=change-me-to-a-very-long-random-secret-minimum-32-chars

# ──────────────────────────────────────────────────────────────
# Environment
# ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ──────────────────────────────────────────────────────────────
# Database (SQLite for production - file-based, no extra config needed)
# libsql URL format: libsql:file:/app/data/agenthub.db
# ──────────────────────────────────────────────────────────────
DATABASE_URL=libsql:file:/app/data/agenthub.db

# ──────────────────────────────────────────────────────────────
# CORS - Set to your production domain
# Example: ALLOWED_ORIGINS=https://agenthub.com,https://www.agenthub.com
# ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://your-domain.com

# ──────────────────────────────────────────────────────────────
# OAuth (Optional - for GitHub/Google login)
# ──────────────────────────────────────────────────────────────

# GitHub OAuth App
# Create at: https://github.com/settings/developers
# Callback URL: https://your-domain.com/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth 2.0
# Create at: https://console.cloud.google.com/apis/credentials
# Callback URL: https://your-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth redirect URI (must match OAuth provider settings)
OAUTH_REDIRECT_URI=https://your-domain.com/api/auth/github/callback

# ──────────────────────────────────────────────────────────────
# Email / SMTP (Optional - for email notifications)
# ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@your-domain.com

# ──────────────────────────────────────────────────────────────
# MeiliSearch (Optional - for full-text search)
# ──────────────────────────────────────────────────────────────
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=

# ──────────────────────────────────────────────────────────────
# Frontend URLs (used for OAuth redirects and links in emails)
# ──────────────────────────────────────────────────────────────
FRONTEND_URL=https://your-domain.com

# ──────────────────────────────────────────────────────────────
# Next.js Public Variables (build-time)
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://your-domain.com
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_TELEMETRY_DISABLED=1
