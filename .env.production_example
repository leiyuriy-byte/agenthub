# ============================================================
# AgentHub Production Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!
# ============================================================

# ──────────────────────────────────────────────────────────────
# REQUIRED - Must be set before deployment
# ──────────────────────────────────────────────────────────────

# JWT Secret Key (generate with: openssl rand -base64 48 | tr -d '/+=' | head -c 64)
JWT_SECRET=change-me-to-a-very-long-random-secret-minimum-32-chars

# ──────────────────────────────────────────────────────────────
# Environment
# ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ──────────────────────────────────────────────────────────────
# Database (SQLite for production - file-based, no extra config needed)
# libsql URL format: libsql:file:/app/data/agenthub.db
# ──────────────────────────────────────────────────────────────
DATABASE_URL=libsql:file:/app/data/agenthub.db

# ──────────────────────────────────────────────────────────────
# CORS - Set to your production domain
# Example: ALLOWED_ORIGINS=https://agenthub.com,https://www.agenthub.com
# ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://your-domain.com

# ──────────────────────────────────────────────────────────────
# OAuth (Optional - for GitHub/Google login)
# ──────────────────────────────────────────────────────────────

# GitHub OAuth App
# Create at: https://github.com/settings/developers
# Callback URL: https://your-domain.com/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth 2.0
# Create at: https://console.cloud.google.com/apis/credentials
# Callback URL: https://your-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth redirect URI (must match OAuth provider settings)
OAUTH_REDIRECT_URI=https://your-domain.com/api/auth/github/callback

# ──────────────────────────────────────────────────────────────
# Email / SMTP (Optional - for email notifications)
# ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@your-domain.com

# ──────────────────────────────────────────────────────────────
# Storage (Optional - for image/file uploads in production)
# Set STORAGE_PROVIDER=s3 to enable S3-compatible storage
# Supports: AWS S3, Cloudflare R2, MinIO, and other S3-compatible services
# ──────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local  # 'local' or 's3'

# Local storage settings (default, for development)
# UPLOAD_DIR=/app/uploads

# ──────────────────────────────────────────────────────────────
# S3-Compatible Storage Configuration
# ──────────────────────────────────────────────────────────────

# Option 1: AWS S3 + CloudFront CDN (recommended for global)
# S3_BUCKET=agenthub-media
# S3_REGION=us-east-1
# S3_PUBLIC_URL=https://cdn.your-domain.com  # CloudFront distribution domain

# Option 2: Cloudflare R2 (no egress fees, ideal for media)
# S3_BUCKET=agenthub
# S3_REGION=auto
# S3_ENDPOINT=https://abc.cloudflarestorage.com  # R2 endpoint from dashboard
# S3_ACCESS_KEY=r2_access_key
# S3_SECRET_KEY=r2_secret_key
# S3_PUBLIC_URL=https://cdn.your-domain.com  # R2 Custom Domain

# Option 3: MinIO (self-hosted, free)
# S3_BUCKET=agenthub
# S3_REGION=us-east-1
# S3_ENDPOINT=https://minio.your-domain.com
# S3_ACCESS_KEY=minio_admin
# S3_SECRET_KEY=minio_password
# S3_PUBLIC_URL=https://minio.your-domain.com

# Option 4: Alibaba Cloud OSS
# S3_BUCKET=agenthub-media
# S3_REGION=oss-cn-hangzhou
# S3_ENDPOINT=https://agenthub-media.oss-cn-hangzhou.aliyuncs.com
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key
# S3_PUBLIC_URL=https://cdn.your-domain.com

# ──────────────────────────────────────────────────────────────
# MeiliSearch (Optional - for full-text search)
# ──────────────────────────────────────────────────────────────
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=

# ──────────────────────────────────────────────────────────────
# Frontend URLs (used for OAuth redirects and links in emails)
# ──────────────────────────────────────────────────────────────
FRONTEND_URL=https://your-domain.com

# ──────────────────────────────────────────────────────────────
# Next.js Public Variables (build-time)
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://your-domain.com
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_TELEMETRY_DISABLED=1
